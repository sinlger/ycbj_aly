---
import "../styles/global.css";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- Basic Meta Tags -->
<title>CutPicGo - AI 智能一键抠图</title>
<meta
  name="description"
  content="CutPicGo - AI 智能一键抠图，自动识别主体并去除背景，让创意设计更轻松。"
/>
<meta name="keywords" content="AI抠图, 去背景, 智能抠图, 在线抠图, CutPicGo" />
<meta name="author" content="CutPicGo" />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="any" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/logo.svg" type="image/x-icon" />

<!-- Open Graph / Facebook -->
<meta property="og:image" content="/og-image.png" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://cutpicgo.com/" />
<meta property="og:title" content="CutPicGo - AI 智能一键抠图" />
<meta
  property="og:description"
  content="CutPicGo - AI 智能一键抠图，自动识别主体并去除背景，让创意设计更轻松。"
/>
<meta
  property="og:image"
  content="https://cutpicgo.com/og-image.png"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://cutpicgo.com/" />
<meta property="twitter:title" content="CutPicGo - AI 智能一键抠图" />
<meta
  property="twitter:description"
  content="CutPicGo - AI 智能一键抠图，自动识别主体并去除背景，让创意设计更轻松。"
/>
<meta
  property="twitter:image"
  content="https://cutpicgo.com/og-image.png"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://cutpicgo.com/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Apple Touch Icon (already included in favicons, but keeping for backwards compatibility) -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#ffffff" />

<!---- Alpine  -->
<script is:inline defer src="https://unpkg.com/alpinejs@3.10.5/dist/cdn.min.js">
</script>
